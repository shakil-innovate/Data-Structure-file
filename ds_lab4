from multiprocessing.pool import ThreadPool
import threading
import os

documents=[
    "I like coding coding coding coding every day",
    "This is very very very very important",
    "We need to practice practice practice practice regularly",
    "He plays football football football football every evening",
    "Learning programming programming programming programming is fun",
]

def map_task(doc_id,text):
  pairs=[]

  for word in text.split():
    pairs.append((word,1))

  return pairs


def shuffle(all_maped_pair,num_reducer):
  groups={}

  for pair in all_maped_pair:
    for word,cnt in pair:
      groups.setdefault(word,[]).append(cnt)

  buckets=[{} for _ in range (num_reducer)]

  for word,cnt in groups.items():
    id=hash(word)%num_reducer
    buckets[id][word]=cnt

  return buckets

def reduce_task(bucket_it,bucket):
  result={}
  for word,cnt in bucket.items():
    result[word]=sum(cnt)
  return result


def main():
  print(f"Enter into main")

  with ThreadPool(processes=4) as pool:
    map_result=pool.starmap(
        map_task,[(i,doc) for i,doc in enumerate(documents)]
    )

  print("map result:")
  print(map_result)

  buckets=shuffle(map_result,3)

  print("after shuffle:")
  print(buckets)

  with ThreadPool(processes=3) as pool:
    reduced_result=pool.starmap(
        reduce_task,list(enumerate(buckets))
    )

  print("after reduced:")
  print(reduced_result)

  final_cnt={}

  for partial in reduced_result:
    final_cnt.update(partial)

  for word,cnt in sorted(final_cnt.items(), key=lambda kv:-kv[1]):
    print(f"{word}:{cnt}")

